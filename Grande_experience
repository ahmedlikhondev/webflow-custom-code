<title>The World Tour</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap">
<style>
:root{
  --paper:#FAF8F3;
  --surface:#FFFFFF;
  --surface-2:#F1EEE6;
  --ink:#15130F;
  --muted:#6E6A61;
  --line:#E3DFD3;
  --red:#E30613;
  --red-dark:#B8050F;
  --red-tint:#FDEAEA;
  --shadow: 0 1px 2px rgba(20,15,5,.06);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#121110;
    --surface:#191714;
    --surface-2:#211E19;
    --ink:#F3F0E8;
    --muted:#9C978B;
    --line:#332F27;
    --red:#FF4650;
    --red-dark:#FF7078;
    --red-tint:#2B1512;
    --shadow: 0 1px 2px rgba(0,0,0,.4);
  }
}
:root[data-theme="dark"]{
  --paper:#121110;
  --surface:#191714;
  --surface-2:#211E19;
  --ink:#F3F0E8;
  --muted:#9C978B;
  --line:#332F27;
  --red:#FF4650;
  --red-dark:#FF7078;
  --red-tint:#2B1512;
  --shadow: 0 1px 2px rgba(0,0,0,.4);
}

*{box-sizing:border-box;}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:'Outfit',Arial,sans-serif;
  margin:0;
  -webkit-font-smoothing:antialiased;
}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace; font-variant-numeric:tabular-nums;}

.wrap{max-width:1120px; margin:0 auto; padding:0 28px;}

/* ---------- HERO ---------- */
.hero{padding:76px 0 44px; border-bottom:1px solid var(--line);}
.hero-eyebrow{
  display:flex; align-items:center; gap:10px;
  font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase;
  color:var(--red); margin-bottom:22px;
}
.hero-eyebrow::before{content:""; width:22px; height:2px; background:var(--red); display:inline-block;}
.hero-grid{display:grid; grid-template-columns:1.35fr 1fr; gap:48px; align-items:end;}
h1.title{
  font-size:clamp(40px,6vw,74px); font-weight:900; line-height:0.98; letter-spacing:-.02em;
  margin:0; text-wrap:balance;
}
h1.title em{font-style:normal; color:var(--red);}
.hero-sub{
  font-size:17px; line-height:1.55; color:var(--muted); max-width:46ch; margin:22px 0 0;
}
.stamp{
  justify-self:end; text-align:right; border:1.5px solid var(--line); border-radius:4px;
  padding:20px 22px; background:var(--surface); box-shadow:var(--shadow);
}
.stamp .n{font-family:'JetBrains Mono',monospace; font-size:56px; font-weight:600; line-height:1; color:var(--red);}
.stamp .l{font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-top:6px;}

/* ---------- STAT STRIP ---------- */
.stats{
  display:grid; grid-template-columns:repeat(4,1fr);
  border-bottom:1px solid var(--line);
}
.stat{
  padding:26px 28px; border-left:1px solid var(--line);
}
.stat:first-child{border-left:none;}
.stat .num{font-family:'JetBrains Mono',monospace; font-size:30px; font-weight:600; letter-spacing:-.01em;}
.stat .lab{font-size:12.5px; color:var(--muted); margin-top:4px;}

/* ---------- INTRO ---------- */
.intro{padding:52px 0 8px; display:grid; grid-template-columns:200px 1fr; gap:40px;}
.intro h2{font-size:13px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin:6px 0 0; font-weight:600;}
.intro p{font-size:16.5px; line-height:1.65; max-width:64ch; margin:0; color:var(--ink);}
.intro p + p{margin-top:14px;}

/* ---------- CONTROLS ---------- */
.controls{
  position:sticky; top:0; z-index:5; background:var(--paper);
  padding:26px 0 14px; margin-top:26px;
  border-bottom:1px solid var(--line);
  display:flex; flex-wrap:wrap; align-items:center; gap:10px 12px;
}
.chip{
  font-family:'Outfit',sans-serif; font-size:13px; font-weight:600; letter-spacing:.02em;
  border:1px solid var(--line); background:var(--surface); color:var(--ink);
  padding:8px 14px; border-radius:100px; cursor:pointer; white-space:nowrap;
}
.chip[aria-pressed="true"]{background:var(--red); border-color:var(--red); color:#fff;}
.search-wrap{margin-left:auto; position:relative;}
#search{
  font-family:'Outfit',sans-serif; font-size:14px; padding:9px 14px 9px 34px;
  border:1px solid var(--line); border-radius:100px; background:var(--surface); color:var(--ink);
  width:220px; outline:none;
}
#search:focus{border-color:var(--red);}
.search-wrap::before{
  content:"⌕"; position:absolute; left:13px; top:50%; transform:translateY(-50%);
  color:var(--muted); font-size:15px; pointer-events:none;
}
#empty-state{display:none; padding:40px 0; color:var(--muted); font-size:15px;}

/* ---------- REGIONS / TOUR LIST ---------- */
.regions{padding:8px 0 20px;}
.region{padding:34px 0 8px;}
.region-head{
  display:flex; align-items:baseline; gap:10px; margin-bottom:8px;
}
.region-head h3{font-size:22px; font-weight:800; margin:0; letter-spacing:-.01em;}
.tour-list{list-style:none; margin:6px 0 0; padding:0; border-top:1px solid var(--line);}
.tour-row{
  display:grid;
  grid-template-columns: 190px 170px 1fr 64px;
  align-items:center; gap:16px;
  padding:11px 4px;
  border-bottom:1px solid var(--line);
  font-size:14.5px;
}
.tour-row:hover{background:var(--surface-2);}
.t-city{font-weight:700;}
.t-country{color:var(--muted);}
.t-pills{display:flex; flex-wrap:wrap; gap:6px;}
.pill{
  font-size:11.5px; font-weight:600; letter-spacing:.01em;
  padding:4px 9px; border-radius:100px;
  background:var(--red-tint); color:var(--red-dark);
  white-space:nowrap;
}
.pill-muted{background:var(--surface-2); color:var(--muted);}
.t-year{font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--muted); text-align:right;}

@media (max-width:760px){
  .hero-grid{grid-template-columns:1fr;}
  .stamp{justify-self:start; text-align:left;}
  .stats{grid-template-columns:repeat(2,1fr);}
  .stat:nth-child(3){border-left:none;}
  .intro{grid-template-columns:1fr; gap:10px;}
  .tour-row{grid-template-columns:1fr 60px; grid-template-areas:"city year" "country country" "pills pills"; row-gap:4px;}
  .t-city{grid-area:city;} .t-year{grid-area:year;} .t-country{grid-area:country;} .t-pills{grid-area:pills;}
  .search-wrap{margin-left:0; width:100%;}
  #search{width:100%;}
}

footer{border-top:1px solid var(--line); padding:26px 0 60px;}
footer p{font-size:12.5px; color:var(--muted); margin:0;}
</style>


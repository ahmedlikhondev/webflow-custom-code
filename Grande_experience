<script>
(function(){
  var regionsEl = document.getElementById('regions');
  var sections = Array.prototype.slice.call(regionsEl.querySelectorAll('.region'));
  var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
  var search = document.getElementById('search');
  var emptyState = document.getElementById('empty-state');
  var activeRegion = 'all';

  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      chips.forEach(function(c){ c.setAttribute('aria-pressed','false'); });
      chip.setAttribute('aria-pressed','true');
      activeRegion = chip.getAttribute('data-region');
      applyFilters();
    });
  });

  search.addEventListener('input', applyFilters);

  function applyFilters(){
    var q = search.value.trim().toLowerCase();
    var anyVisible = false;
    sections.forEach(function(section){
      var region = section.getAttribute('data-region');
      var regionMatch = (activeRegion === 'all' || activeRegion === region);
      var rows = Array.prototype.slice.call(section.querySelectorAll('.tour-row'));
      var sectionHasVisible = false;
      rows.forEach(function(row){
        var text = row.textContent.toLowerCase();
        var rowMatch = regionMatch && (q === '' || text.indexOf(q) !== -1);
        row.style.display = rowMatch ? '' : 'none';
        if(rowMatch){ sectionHasVisible = true; anyVisible = true; }
      });
      section.style.display = sectionHasVisible ? '' : 'none';
    });
    emptyState.style.display = anyVisible ? 'none' : 'block';
  }
})();
</script>

